@import "../../pages/font/iconfont.wxss";

.card {
  border-radius: 5px;
  overflow: hidden;
  flex-shrink: 0;
  width: 100%;
  background-color: white;
  position: relative;
}
.card_like {
    display: flex;
    align-items: center;
    width: auto;
    height: 18px;
    margin-left: 5px; /* 与图标保持一定间距 */
    font-size: 12px;
    color: #666666;
  }
.card_wrap {
  position: absolute;
  transform-origin: 0 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  min-height: 100%;
}

.card_img {
  width: 100%; 
  border-top-right-radius: 5px;
  border-top-left-radius: 5px;
}

.card_content {
  padding: 8px;
  font-size: 14px;
  font-weight: 500;
  overflow: hidden;
  word-break: break-all;
}

.card_footer {
  padding: 0 8px 10px;
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 12px;
  color: #666666;
  line-height: 20px;
  justify-content: flex-end;
  min-height: 30px;
}

.card_avatar {
  width: 18px;
  height: 18px;
  display: block;
  flex-shrink: 0;
  font-size: 16px;
  color: #666666;
}

.card_avatar.icon-guanzhu-zhihui {
  color: #ff4757;
}

.card_avatar.icon-xihuan {
  color: #666666;
}

.card_nickname {
  flex: 1;
  padding-left: 4px;
}
