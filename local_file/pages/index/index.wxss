@import "../font/iconfont.wxss";

page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #fafafa;
}

scroll-view {
  background: transparent !important;
}

/* ========== Logo 区域样式 ========== */
.logo-wrapper {
  background: linear-gradient(135deg, #5e72e4 0%, #825ee4 100%);
  padding: 24rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(94, 114, 228, 0.2);
}

.logo {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  background-color: #ffffff;
  padding: 6rpx;
  transition: transform 0.3s ease;
}

.logo:active {
  transform: scale(0.95);
}

/* ========== 轮播图区域样式 ========== */
.swiper-wrapper {
  background: linear-gradient(180deg, #6c7ff2 0%, #7b68ee 100%);
  padding: 24rpx 16rpx 32rpx 16rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 轮播图容器 - 严格 16:9 比例 */
.swiper {
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.3);
  background-color: #000;
}

.swiper-item-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1a1a1a;
}

/* 轮播图图片 - 16:9比例，覆盖填充模式 */
.swiper-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

/* 长按视觉反馈 */
.swiper-image:active {
  transform: scale(0.95);
}

/* ========== 瀑布流区域样式 ========== */
.waterfall-wrapper {
  background: linear-gradient(to bottom, #f0f2ff 0%, #fafafa 200rpx);
  min-height: 100vh;
  padding-top: 32rpx;
  position: relative;
}

/* 瀑布流顶部装饰波浪 */
.waterfall-wrapper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(to bottom, rgba(123, 104, 238, 0.15) 0%, transparent 100%);
  pointer-events: none;
}

view, scroll-view, page, image {
  box-sizing: border-box;
}

.safe-area-inset-bottom {
  height: env(safe-area-inset-bottom, 50px);
}

/* 新增：初始化加载状态样式 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #4682b4;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
}

/* 新增：加载更多状态样式 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  gap: 20rpx;
}

.loading-spinner-small {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #e0e0e0;
  border-top: 3rpx solid #4682b4;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-more-text {
  font-size: 28rpx;
  color: #999;
}

/* 新增：数据状态显示样式（调试用） */
.data-status {
  position: fixed;
  top: 200rpx;
  right: 20rpx;
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  z-index: 999;
}

.data-status-text {
  font-size: 24rpx;
}

/* 旋转动画 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}