.scroll-view {
  width: 100%;
  height: 100%;
  /* margin-top: 60px; */
}

.sticky-header {
  background-color: #fff;
}
.search {
  /* width: 200px; */
  border: rgb(228, 226, 226) solid 1px;
  border-radius: 20px;
  margin: 0 10px;
  line-height: 30px;
  height: 30px;
}
.search input {
  padding: 0 10px;
  line-height: 30px;
  height: 30px;
}
.list1 {
  display: flex;
  text-align: center;
  justify-content: center;
  align-items: center;
  margin: 10px 0;
}
.list1 image{
  width: 15vw;
  height: 15vw;
  border-radius: 50%;
}
.list1 text{
  padding: 10px 0;
  font-size: 14px;
}

.list2-head {
  display: flex;
  flex-direction: row;
}
.mini-head {
  display: flex;
  background-color: #f5f5f5;
  margin: 8px 6px;
  padding: 6px 8px;
  border-radius: 4px;
  font-size: 14px;
}
.current {
  background-color: #07c160;
  color: #fff;
}

.grid-box {
  padding: 10px;
  border-radius: 8px;
  background-color: #f5f5f5;
}

.grid-box image {
  width: 100%;
}

.content-box {
  padding-top: 10px;
}

.profile-text {
  display: flex;
  flex-direction: row;
  padding-top: 4px;
  /* justify-content: center; */
  align-items: center;
}

.profile-text view {
  display: flex;
  color: #888;
  font-size: 14px;
  flex-direction: row;
  align-items: center;
}

.left {
  width: 70%;
}
.left .icon {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  margin-right: 4px;
}
.right {
  /* width: 30%; */
  text-align: right;
  color: #888;
  font-size: 14px;
}

.right .icon-collection {
  width: 16px;
  height: 16px;
  background-size: cover;
  opacity: .5;
  color: rgba(0,0,0,.5);
  margin: 0 3px;
}