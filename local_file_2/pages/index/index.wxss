.top-bar {
  height: 50px; /* 默认高度 */
}

@media (max-height: 600px) {
  .top-bar {
    height: 40px; /* 针对小屏幕设备的高度 */
  }
}

@media (min-height: 601px) and (max-height: 800px) {
  .top-bar {
    height: 60px; /* 针对中等屏幕设备的高度 */
  }
}

@media (min-height: 801px) {
  .top-bar {
    height: 70px; /* 针对大屏幕设备的高度 */
  }
}

.search, .logo, .help {
  flex: 1;
  text-align: center;
  margin: 0 5px;
  padding: 5px;
  border-radius: 5px;
  font-size: 16px;
}

.search {
  border: 2px solid #87ceeb;
  transition: all 0.3s ease;
}

.search:focus {
  border-color: #4682b4;
  box-shadow: 0 0 5px #4682b4;
}

.logo {
  font-weight: bold;
  color: #4682b4;
  text-shadow: 1px 1px 2px #87ceeb;
  background-color: #f0f8ff;
}

.help {
  background-color: #87ceeb;
  border: none;
  color: white;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.help:hover {
  background-color: #4682b4;
}

.swiper {
  width: 100%;
  height: 30vh;
  overflow: hidden;
}

.slide-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  width: 100%;
  height: 100%;
}

.slide-image {
  width: 45%; /* 每张图片占45%宽度 */
  height: 100%; /* 保持图片比例 */
  object-fit: cover;
}

.waterfall {
  height: calc(100vh - 400px); /* Adjust based on your layout */
}

.waterfall-image {
  width: 100%;
  margin-bottom: 10px;
} 