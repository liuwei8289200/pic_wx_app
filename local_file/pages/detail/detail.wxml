<pan-gesture-handler worklet:ongesture="handlePanGesture">
	<view id="fake-host">
		<view id="page" bindtap="onPageTap">
			<view class="navigation-bar">
				<view class="navigation-bar-content">
					<view class="navigation-bar-left">
						<text class="navigation-bar-back iconfont icon-shouye-zhihui" bindtap="goHome"></text>
					</view>
					<view class="navigation-bar-title">{{short_title}}</view>
					<!-- <view class="navigation-bar-follow">关注</view> -->
				</view>
			</view>
			<share-element
			 key="se-key{{index}}"
			 shuttle-on-push="from"
			 transition-on-gesture="{{true}}"
			 rect-tween-type="cubic-bezier(0.4, 0.0, 0.2, 1.0)"
			 style="width: 100%; height: 0px;"
			>
				<view/>
			</share-element>

			<scroll-view
			 scroll-y
			 style="flex: 1; width: 100%; overflow: hidden;"
			 type="list"
			 show-scrollbar="{{false}}"
			>
				<view>
					<image 
            class="detail-image" 
            mode="widthFix" 
            src="{{url}}" 
            style="width: 100%; height: {{swiperHeight}}px;" 
            bindlongpress="saveImageToAlbum" 
            bindtap="previewImage" 
          />
				</view>
				<view class="detail-content">
				<view class="detail-title">{{title}}</view>
          		<view class="detail-p" style="padding-bottom: 20px;" />
				<view class="detail-p">🔥 {{content}}</view>
          		<view class="detail-p" style="padding-bottom: 10px;" />
				</view>

				<view class="comments-section">
					<view v-if="comments.length > 0" class="comments-title">评论 ({{comments.length}})</view>
					<view class="comment-list">
						<view class="comment-item" wx:for="{{comments}}" wx:key="_id">
							<image class="comment-avatar" src="{{item.avatar}}" />
							<view class="comment-content">
								<view class="comment-user">{{item.username}}</view>
								<view class="comment-text">{{item.content}}</view>
								<view class="comment-time">{{item.time}}</view>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>
			<view class="footer">
				<view class="footer-content">
					<!-- 左侧分享按钮 -->
					<button class="action-item share-btn" open-type="share">
						<text class="action-icon iconfont icon-a-fenxiang2"></text>
						<text class="action-text">分享</text>
					</button>

					<!-- 右侧操作按钮组 -->
					<view class="right-actions">
						<!-- 点赞按钮 -->
						<view class="action-item like-btn" bindtap="{{!isLoading ? 'handleLike' : ''}}">
							<text class="action-icon iconfont {{isLoading ? 'icon-xihuan' : (isLiked ? 'icon-guanzhu-zhihui' : 'icon-xihuan')}}"></text>
							<text class="action-text {{isLoading ? 'skeleton skeleton-text' : ''}}">{{isLoading ? '' : (likeCount > 0 ? likeCount + '+' : '0')}}</text>
						</view>

						<!-- 评论按钮 -->
						<view class="action-item comment-btn" catchtap="{{!isLoading ? 'showCommentInput' : ''}}">
							<text class="action-icon iconfont icon-xiaoxi-zhihui"></text>
							<text class="action-text {{isLoading ? 'skeleton skeleton-text' : ''}}">{{isLoading ? '' : (commentCount > 0 ? commentCount + '+' : '0')}}</text>
						</view>
					</view>
				</view>
			</view>
			<!-- 评论输入框浮层 -->
			<view class="comment-input-layer" wx:if="{{showCommentInput}}" catchtap="stopPropagation">
				<view class="comment-input-wrapper">
					<input 
						class="comment-input" 
						placeholder="写下你的评论..." 
						value="{{commentText}}"
						focus="{{showCommentInput}}"
						bindinput="onCommentInput"
					/>
					<view class="send-btn" bindtap="sendComment">发送</view>
				</view>
			</view>
			
			<!-- 图片全屏预览浮层 -->
			<view class="image-preview-container" wx:if="{{isImagePreview}}" catchtap="closeImagePreview">
				<image 
					class="preview-image" 
					mode="aspectFit" 
					src="{{url}}" 
					style="{{previewStyle}}"
					catchtap="stopPropagation" 
				/>
				<view class="preview-close" catchtap="closeImagePreview">×</view>
			</view>
		</view>
	</view>
</pan-gesture-handler>