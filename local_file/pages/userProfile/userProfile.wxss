/* pages/userProfile/userProfile.wxss */
page {
  background-color: #f5f5f5;
}

.page-container {
  padding: 30rpx;
  padding-top: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 40rpx;
  margin-top: 20rpx;
}

.avatar-section, .nickname-section {
  background-color: #ffffff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 30rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: transparent;
}

.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.avatar-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.nickname-input {
  height: 80rpx;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.save-btn {
  margin-top: 60rpx;
  background-color: #07c160;
  color: white;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
} 