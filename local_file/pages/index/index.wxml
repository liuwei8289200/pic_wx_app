<!--pages/index/index.wxml-->
<navigation-bar back="{{false}}" title="梦幻国王"></navigation-bar>
<view class="top-bar">
  <image class="logo" src="../../images/logo.png" mode="aspectFit" bindlongpress="toggleDebugInfo" />
</view>

<!-- 新增：初始化状态提示 -->
<view wx:if="{{isInitializing}}" class="loading-container">
  <view class="loading-content">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载精彩内容...</text>
  </view>
</view>

<scroll-view
 scroll-y
 style="flex: 1; width: 100%; overflow: hidden; padding: {{padding}}px; padding-bottom: 0;"
 type="custom"
 show-scrollbar="{{false}}"
 bindscrolltolower="loadMore"
 wx:if="{{!isInitializing}}"
>
<swiper class="swiper" autoplay="true" interval="3000" indicator-dots="true" indicator-active-color="#4682b4">
  <block wx:for="{{swiperImages}}" wx:key="*this">
    <swiper-item wx:if="{{index % 2 === 0}}">
      <view class="slide-container">
        <image src="{{item}}" class="slide-image"/>
        <image src="{{swiperImages[index + 1]}}" class="slide-image"/>
      </view>
    </swiper-item>
  </block>
</swiper>

  <!-- 新增：数据状态提示（调试模式下显示，长按logo可切换显示） -->
  <view wx:if="{{showDebugInfo && dataStatus}}" class="data-status" bindtap="getDataStatus">
    <text class="data-status-text">已浏览: {{dataStatus.viewedCount}} | 剩余: {{dataStatus.remainingCount}}</text>
    <text class="data-status-text">全量已加载: {{dataStatus.isAllDataLoaded ? '是' : '否'}}</text>
  </view>

  <grid-view type="masonry">
    <card
      wx:for="{{gridList}}"
      wx:key="id"
      card-width="{{cardWidth}}"
      index="{{index}}"
      item="{{item}}"
    />
  </grid-view>
  
  <!-- 新增：加载更多状态提示 -->
  <view wx:if="{{isLoading && !isInitializing}}" class="loading-more">
    <view class="loading-spinner-small"></view>
    <text class="loading-more-text">加载更多...</text>
  </view>
</scroll-view>