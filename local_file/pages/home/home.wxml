<!--pages/home/home.wxml-->
<navigation-bar back title="我的点赞列表"></navigation-bar>
<scroll-view
 scroll-y
 style="flex: 1; width: 100%; overflow: hidden; padding: {{padding}}px; padding-bottom: 0;"
 type="custom"
 show-scrollbar="{{false}}"
 bindscrolltolower="loadMore"
>
  <grid-view
    type="masonry"
  >
    <card
      wx:for="{{gridList}}"
      wx:key="id"
      card-width="{{cardWidth}}"
      index="{{index}}"
      item="{{item}}"
    />
  </grid-view>
</scroll-view>