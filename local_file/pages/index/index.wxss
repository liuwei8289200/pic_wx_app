page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

scroll-view {
  background-color: #f4f4f4;
}

.swiper {
  width: 100%;
  height: 30vh;
  overflow: hidden;
}

.slide-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  width: 100%;
  height: 100%;
}

view, scroll-view, page, image {
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10px;
  background-color: #f0f8ff;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.logo {
  width: 30px;
  height: 30px;
}

.safe-area-inset-bottom {
  height: env(safe-area-inset-bottom, 50px);
}