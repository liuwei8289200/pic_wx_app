scroll-view {
  background-color: #f5f5f5;
  margin-top: 46px;
}
.grid-box {
  width: 33vw;
  height: 44vw;
  padding: 10px;
  border-radius: 8px;
  background-color: #fff;
  justify-content: space-around;
  position: relative;
}

.grid-box image {
  width: 100%;
}

.look {
  position: absolute;
  width: 100%;
  height: 20px;
  line-height: 20px;
  background-color: rgba(0,0,0,.3);
  border-radius: 4px 4px 0 0;
  text-align: right;
  color: #fff;
  padding-right: 10px;
  right: 0;
  bottom: 0;
  font-size: 12px;
}

.content-box {
  padding-top: 10px;
}

.profile-text {
  display: flex;
  flex-direction: row;
  padding-top: 4px;
  align-self: flex-end;
}

.profile-text view {
  display: flex;
  color: #888;
  font-size: 14px;
}

.left {
  width: 70%;
}
.right {
  /* width: 30%; */
  text-align: right;
  flex-direction: row;
  color: #888;
  font-size: 14px;
}

.right .icon-collection {
  width: 16px;
  height: 16px;
  background-size: cover;
  opacity: .5;
  color: rgba(0,0,0,.5);
  margin: 0 3px;
}