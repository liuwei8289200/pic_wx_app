@import "../font/iconfont.wxss";

page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: transparent;
}

view, scroll-view, page, image {
  box-sizing: border-box;
}

#fake-host {
  background-color: #FFF;
  border-radius: 10px;
  overflow: hidden;
}

#page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.navigation-bar {
  padding-top: 44px;
  padding-top: env(safe-area-inset-top);
  background-color: white;
}

.navigation-bar-content {
  height: 44px;
  display: flex;
  flex-direction: row;
  padding: 0 20px;
  align-items: center;
  font-size: 14px;
}

.navigation-bar-left {
  display: flex;
  align-items: center;
  width: 60px;
}

.navigation-bar-back {
  width: 16px;
  height: 16px;
  margin-right: 8px;
}

.navigation-bar-avatar {
  width: 24px;
  height: 24px;
  border-radius: 100%;
}

.navigation-bar-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.navigation-bar-title {
  max-width: 70%;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.navigation-bar-follow {
  color: red;
  border: .5px solid red;
  border-radius: 15px;
  padding: 3px 15px;
  margin-right: 80px;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-content {
  padding: 15px;
}

.detail-title {
  font-weight: bold;
  font-size: 18px;
  padding-bottom: 3px;
}

.detail-p {
  padding-bottom: 2px;
}

/* 图片预览样式 */
.image-preview-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.9);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.preview-image {
  position: absolute;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.preview-close {
  position: absolute;
  top: 30px;
  right: 30px;
  width: 40px;
  height: 40px;
  line-height: 36px;
  text-align: center;
  font-size: 30px;
  color: #fff;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  z-index: 1001;
  /* 添加安全区域顶部内边距 */
  padding-top: env(safe-area-inset-top);
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  padding: 20rpx;
  z-index: 100;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin: 0 20rpx;
}

.action-group {
  display: flex;
  align-items: center;
  height: 3rem
}

/* 右侧按钮组的样式 */
.right-actions {
  display: flex;
  gap: 40rpx;
  margin-right: 20rpx;
}

.action-btn {
  background: none;
  border: none;
  padding: 0;
}

.share-btn {
  background: none;
  border: none;
  padding: 0;
  line-height: normal;
  display: flex;
  align-items: center;
}

.tmp-b{
  width: 5rem;
}

.tmp-a{
  margin-left: 0.05rem;
}

.share-btn::after {
  border: none;
}

.action-btn-inner {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
}

.action-icon {
  width: 39rpx;
  height: 39rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666666;
  margin-right: 12rpx;
}

.action-icon.icon-guanzhu-zhihui {
  color: #ff4757;
}

.action-icon.icon-xihuan {
  color: #666666;
}

/* 点赞激活状态的颜色 */
.icon-xihuan {
  color: #ff4d4f;
}

.action-text {
  font-size: 28rpx;
  color: #666;
  line-height: 48rpx;
}

/* 骨架屏样式 */
@keyframes shimmer {
  0% {
    background-position: -200px 0;
  }
  100% {
    background-position: 200px 0;
  }
}

.skeleton {
  background: linear-gradient(to right, #f6f6f6 8%, #f0f0f0 18%, #f6f6f6 33%);
  background-size: 800px 104px;
  animation-duration: 1.5s;
  animation-fill-mode: forwards;
  animation-iteration-count: infinite;
  animation-name: shimmer;
  animation-timing-function: linear;
}

.skeleton-text {
  height: 28rpx;
  width: 30px;
  border-radius: 4rpx;
}

.comment-input-layer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 101;
}

.comment-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 102;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.send-btn {
  padding: 12rpx 30rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.comments-section {
  padding: 20rpx;
  margin-bottom: 120rpx;
}

.comments-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 8rpx solid #07c160;
}

.comment-list {
  display: flex;
  flex-direction: column;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  position: relative;
}

.comment-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 32rpx;
  top: 80rpx;
  bottom: 0;
  width: 2rpx;
  background-color: #eee;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
  background-color: #f8f8f8;
  border-radius: 10rpx;
  padding: 16rpx;
  position: relative;
}

.comment-content::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 20rpx;
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-right: 16rpx solid #f8f8f8;
}

.comment-user {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #333;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}