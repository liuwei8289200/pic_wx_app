@import "../font/iconfont.wxss";

page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f4f4f4;
}

scroll-view {
  background-color: #f4f4f4;
}

/* ========== 轮播图区域样式 ========== */
.swiper-wrapper {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 16rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 12rpx;
}

/* 轮播图容器 - 严格1:1比例 */
.swiper {
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.2);
  background-color: #fff;
}

.swiper-item-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
}

/* 轮播图图片 - 16:9比例，覆盖填充模式 */
.swiper-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

/* 长按视觉反馈 */
.swiper-image:active {
  transform: scale(0.95);
}

/* ========== 瀑布流区域样式 ========== */
.waterfall-wrapper {
  background-color: #f4f4f4;
  min-height: 100vh;
  padding-top: 20rpx;
}

view, scroll-view, page, image {
  box-sizing: border-box;
}

.safe-area-inset-bottom {
  height: env(safe-area-inset-bottom, 50px);
}

/* 新增：初始化加载状态样式 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #4682b4;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
}

/* 新增：加载更多状态样式 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  gap: 20rpx;
}

.loading-spinner-small {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #e0e0e0;
  border-top: 3rpx solid #4682b4;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-more-text {
  font-size: 28rpx;
  color: #999;
}

/* 新增：数据状态显示样式（调试用） */
.data-status {
  position: fixed;
  top: 200rpx;
  right: 20rpx;
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  z-index: 999;
}

.data-status-text {
  font-size: 24rpx;
}

/* 旋转动画 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}