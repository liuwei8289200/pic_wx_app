page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}
 
 .top-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10px;
  background-color: #f0f8ff;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.search, .logo, .help {
  flex: 1;
  text-align: center;
  margin: 0 5px;
  padding: 5px;
  border-radius: 5px;
  font-size: 16px;
}

.search {
  border: 2px solid #87ceeb;
  transition: all 0.3s ease;
}

.search-focused {
  border-color: #4682b4;
  box-shadow: 0 0 5px #4682b4;
}
.logo {
  font-weight: bold;
  color: #4682b4;
  text-shadow: 1px 1px 2px #87ceeb;
  background-color: #f0f8ff;
}

.help {
  background-color: #87ceeb;
  border: none;
  color: white;
  transition: background-color 0.3s ease;
}

.help-active {
  background-color: #4682b4;
}

.swiper {
  width: 100%;
  height: 30vh;
  overflow: hidden;
}

.slide-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  width: 100%;
  height: 100%;
}
scroll-view {
  background-color: #f4f4f4;
}

view, scroll-view, page, image {
  box-sizing: border-box;
}
.grid-box {
  width: 33vw;
  height: 44vw;
  padding: 10px;
  border-radius: 8px;
  background-color: #fff;
  justify-content: space-around;
  position: relative;
}

.grid-box image {
  width: 100%;
}


.cnt {
    top: 0;
    width: 100%;
    height: 50%;
    display: flex;
    flex-direction: column;
}
  
.album {
    height: 0;
    flex: 1;
    margin-bottom: 12px;
}
  
.safe-area-inset-bottom {
    height: env(safe-area-inset-bottom, 50px);
}