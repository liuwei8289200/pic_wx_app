page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: transparent;
}

view, scroll-view, page, image {
  box-sizing: border-box;
}

#fake-host {
  background-color: #FFF;
  border-radius: 10px;
  overflow: hidden;
}

#page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.navigation-bar {
  padding-top: 44px;
  padding-top: env(safe-area-inset-top);
  background-color: white;
}

.navigation-bar-content {
  height: 44px;
  display: flex;
  flex-direction: row;
  padding: 0 20px;
  justify-content: center;
  align-items: center;
  font-size: 14px;
}

.navigation-bar-avatar {
  width: 24px;
  height: 24px;
  border-radius: 100%;
}

.navigation-bar-title {
  flex: 1;
  padding-left: 8px;
}

.navigation-bar-follow {
  color: red;
  border: .5px solid red;
  border-radius: 15px;
  padding: 3px 15px;
  margin-right: 80px;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-content {
  padding: 15px;
}

.detail-title {
  font-weight: bold;
  font-size: 18px;
  padding-bottom: 3px;
}

.detail-p {
  padding-bottom: 2px;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  padding: 20rpx;
  z-index: 100;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin: 0 20rpx;
}

.action-group {
  display: flex;
  align-items: center;
  height: 3rem
}

/* 右侧按钮组的样式 */
.right-actions {
  display: flex;
  gap: 40rpx;
  margin-right: 20rpx;
}

.action-btn {
  background: none;
  border: none;
  padding: 0;
}

.share-btn {
  background: none;
  border: none;
  padding: 0;
  line-height: normal;
  display: flex;
  align-items: center;
}

.tmp-b{
  width: 5rem;
}

.tmp-a{
  margin-left: 0.05rem;
}

.share-btn::after {
  border: none;
}

.action-btn-inner {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.action-text {
  font-size: 28rpx;
  color: #666;
  line-height: 48rpx;
}

.comment-input-layer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 101;
}

.comment-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 102;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.send-btn {
  padding: 12rpx 30rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.comments-section {
  padding: 20rpx;
  margin-bottom: 120rpx;
}

.comments-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 8rpx solid #07c160;
}

.comment-list {
  display: flex;
  flex-direction: column;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  position: relative;
}

.comment-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 32rpx;
  top: 80rpx;
  bottom: 0;
  width: 2rpx;
  background-color: #eee;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
  background-color: #f8f8f8;
  border-radius: 10rpx;
  padding: 16rpx;
  position: relative;
}

.comment-content::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 20rpx;
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-right: 16rpx solid #f8f8f8;
}

.comment-user {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #333;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}
