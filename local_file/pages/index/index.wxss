@import "../font/iconfont.wxss";

page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

scroll-view {
  background-color: #f4f4f4;
}

.swiper {
  width: 100%;
  height: 30vh;
  overflow: hidden;
}

.slide-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  width: 100%;
  height: 100%;
}

view, scroll-view, page, image {
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10px;
  /* background-color: #f0f8ff; */
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.logo.tmp {
  font-size: 48rpx;  /* 调整图标大小 */
  color: #333;  /* 设置图标颜色 */
}
.logo {
  width: 42px;
  height: 42px;
}

.safe-area-inset-bottom {
  height: env(safe-area-inset-bottom, 50px);
}

/* 新增：初始化加载状态样式 */
.loading-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #4682b4;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
}

/* 新增：加载更多状态样式 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  gap: 20rpx;
}

.loading-spinner-small {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #e0e0e0;
  border-top: 3rpx solid #4682b4;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-more-text {
  font-size: 28rpx;
  color: #999;
}

/* 新增：数据状态显示样式（调试用） */
.data-status {
  position: fixed;
  top: 200rpx;
  right: 20rpx;
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  z-index: 999;
}

.data-status-text {
  font-size: 24rpx;
}

/* 旋转动画 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}