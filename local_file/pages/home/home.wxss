/* pages/home/home.wxss */
page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}
scroll-view {
    background-color: #f4f4f4;
  }
.swiper {
    width: 100%;
    height: 30vh;
    overflow: hidden;
}
.slide-container {
    display: flex;
    justify-content: space-around;
    align-items: center;
    width: 100%;
    height: 100%;
}
view, scroll-view, page, image {
    box-sizing: border-box;
}
 .top-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10px;
  background-color: #f0f8ff;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.search, .logo, .help {
  flex: 1;
  text-align: center;
  margin: 0 5px;
  padding: 5px;
  border-radius: 5px;
  font-size: 16px;
}

.cnt {
    top: 0;
    width: 100%;
    height: 50%;
    display: flex;
    flex-direction: column;
}
  
.album {
    height: 0;
    flex: 1;
    margin-bottom: 12px;
}
  
.safe-area-inset-bottom {
    height: env(safe-area-inset-bottom, 50px);
}

.user-info-container {
  background-color: #ffffff;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.user-info, .user-info-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.nickname {
  font-size: 32rpx;
  font-weight: 500;
}

.login-text {
  font-size: 32rpx;
  color: #666;
}

.tabs {
  display: flex;
  background-color: #ffffff;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #07c160;
  font-weight: 500;
}

.tab.active:after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #07c160;
  border-radius: 3rpx;
}

.content-area {
  background-color: #ffffff;
}

.settings-list {
  padding: 0 30rpx;
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1px solid #eee;
}

.settings-item:last-child {
  border-bottom: none;
}

.arrow-icon {
  width: 40rpx;
  height: 40rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}