<pan-gesture-handler worklet:ongesture="handlePanGesture">
	<view id="fake-host">
		<view id="page" bindtap="onPageTap">
			<view class="navigation-bar">
				<view class="navigation-bar-content">
					<image class="navigation-bar-avatar" src="https://res.wx.qq.com/op_res/BqgN85sXxTbk1kynEEihrwQPXmcn86nOyioRnPAfkrbZteUWsKfEpgoYZ1pk-3TMTc_qXFSElIgkvILR-zzh1Q" />
					<view class="navigation-bar-title">{{short_title}}</view>
					<!-- <view class="navigation-bar-follow">关注</view> -->
				</view>
			</view>
			<share-element
			 key="se-key{{index}}"
			 shuttle-on-push="from"
			 transition-on-gesture="{{true}}"
			 rect-tween-type="cubic-bezier(0.4, 0.0, 0.2, 1.0)"
			 style="width: 100%; height: 0px;"
			>
				<view/>
			</share-element>

			<scroll-view
			 scroll-y
			 style="flex: 1; width: 100%; overflow: hidden;"
			 type="list"
			 show-scrollbar="{{false}}"
			>
				<view>
					<image class="detail-image" mode="widthFix" src="{{url}}" style="width: 100%; height: {{swiperHeight}}px;" bindlongpress="saveImageToAlbum" />
				</view>
				<view class="detail-content">
				<view class="detail-title">{{title}}</view>
          		<view class="detail-p" style="padding-bottom: 20px;" />
				<view class="detail-p">🔥 {{content}}</view>
          		<view class="detail-p" style="padding-bottom: 10px;" />
				</view>

				<view class="comments-section">
					<view v-if="comments.length > 0" class="comments-title">评论 ({{comments.length}})</view>
					<view class="comment-list">
						<view class="comment-item" wx:for="{{comments}}" wx:key="_id">
							<image class="comment-avatar" src="{{item.avatar}}" />
							<view class="comment-content">
								<view class="comment-user">{{item.username}}</view>
								<view class="comment-text">{{item.content}}</view>
								<view class="comment-time">{{item.time}}</view>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>
			<view class="footer">
				<view class="footer-content">
					<!-- 左侧分享按钮 -->
					<view class="action-group tmp-b">
						<button class="share-btn" open-type="share">
							<view class="action-btn-inner">
								<image class="action-icon" src="/images/icon_share.png"></image>
								<text class="action-text">分享</text>
							</view>
						</button>
					</view>

					<!-- 右侧按钮组 -->
					<view class="right-actions">
						<!-- 点赞按钮 - 加载中显示骨架屏 -->
						<view class="action-group tmp-a" bindtap="{{!isLoading ? 'handleLike' : ''}}">
							<view class="action-btn">
								<view class="action-btn-inner">
									<image class="action-icon" src="{{isLoading ? '/images/icon_like.png' : (isLiked ? '/images/icon_like_active.png' : '/images/icon_like.png')}}"></image>
									<text class="action-text {{isLoading ? 'skeleton skeleton-text' : ''}}">{{isLoading ? '' : likeCount}}</text>
								</view>
							</view>
						</view>
						<!-- 评论按钮 - 加载中也显示骨架屏 -->
						<view class="action-group" catchtap="{{!isLoading ? 'showCommentInput' : ''}}">
							<view class="action-btn">
								<view class="action-btn-inner">
									<image class="action-icon" src="/images/icon_comment.png"></image>
									<text class="action-text {{isLoading ? 'skeleton skeleton-text' : ''}}">{{isLoading ? '' : commentCount}}</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
			<!-- 评论输入框浮层 -->
			<view class="comment-input-layer" wx:if="{{showCommentInput}}" catchtap="stopPropagation">
				<view class="comment-input-wrapper">
					<input 
						class="comment-input" 
						placeholder="写下你的评论..." 
						value="{{commentText}}"
						focus="{{showCommentInput}}"
						bindinput="onCommentInput"
					/>
					<view class="send-btn" bindtap="sendComment">发送</view>
				</view>
			</view>
		</view>
	</view>
</pan-gesture-handler>

